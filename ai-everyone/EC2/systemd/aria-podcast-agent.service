[Unit]
Description=ARIA Podcast Agent FastAPI Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/app/agents/aria-podcast-agent
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/ubuntu/app
EnvironmentFile=-/home/ubuntu/app/agents/aria-podcast-agent/.env
ExecStart=/home/ubuntu/app/agents/aria-podcast-agent/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8052
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
