[Unit]
Description=Pian ARIA Podcast Agent
After=network.target

[Service]
WorkingDirectory=/opt/pian/EC2/agents/aria-podcast-agent
EnvironmentFile=/opt/pian/EC2/.env
ExecStart=/opt/pian/EC2/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8052
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
