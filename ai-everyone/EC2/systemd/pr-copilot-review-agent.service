[Unit]
Description=Pian PR Copilot Review Agent
After=network.target

[Service]
WorkingDirectory=/opt/pian/EC2/agents/pr-copilot-review-agent
EnvironmentFile=/opt/pian/EC2/.env
ExecStart=/opt/pian/EC2/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8053
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
