[Unit]
Description=PR Copilot Review Agent FastAPI Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/app/agents/pr-copilot-review-agent
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/ubuntu/app
EnvironmentFile=-/home/ubuntu/app/agents/pr-copilot-review-agent/.env
ExecStart=/home/ubuntu/app/agents/pr-copilot-review-agent/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8053
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
