[Unit]
Description=Pian Labs ALOS Agent FastAPI Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/app/agents/pian-labs-alos-agent
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/ubuntu/app
EnvironmentFile=-/home/ubuntu/app/agents/pian-labs-alos-agent/.env
ExecStart=/home/ubuntu/app/agents/pian-labs-alos-agent/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8054
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
